# External Dependencies
RAGDOLL_KEV_URL=http://192.168.0.12:8008
RAGDOLL_KEV_AUTH_TOKEN=hellothere
RAGDOLL_EMBED_URL=http://192.168.0.12:11434
RAGDOLL_EMBED_MODEL=embeddinggemma-2:740m

# Standard Reranker (FlashRank ONNX)
RAGDOLL_RERANKER_MODEL=ms-marco-TinyBERT-L-2-v2
RAGDOLL_RERANKER_CACHE_DIR=/tmp

# Server Configuration
RAGDOLL_HOST=0.0.0.0
RAGDOLL_PORT=8000

# Storage & Database
RAGDOLL_DB_PATH=data/ragdoll.db
RAGDOLL_STORAGE_PATH=data/uploads

# Pipeline Concurrency & Chunker Tuning
RAGDOLL_CONCURRENCY_LIMIT=6
RAGDOLL_BATCH_EMBED_SIZE=32
RAGDOLL_COARSE_MIN_CHARS=2000
RAGDOLL_COARSE_MAX_CHARS=4000
RAGDOLL_FINE_MIN_CHARS=300
RAGDOLL_FINE_MAX_CHARS=1500
RAGDOLL_REQUEST_TIMEOUT=30.0
